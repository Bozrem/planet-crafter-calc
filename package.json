{
  "name": "planet-crafter-calc",
  "version": "0.1.0",
  "description": "Production calculator for The Planet Crafter",
  "type": "module",
  "bin": {
    "planet-crafter-calc": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.node.json",
    "build:web": "vite build",
    "start": "tsx src/cli/index.ts",
    "calc": "tsx src/cli/index.ts",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^22.13.10",
    "svelte": "^5.20.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
